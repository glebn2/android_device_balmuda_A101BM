From: glebn2 <40612835+glebn2@users.noreply.github.com>
Subject: [PATCH] ims: Run the Android 12 Qualcomm IMS client on Android 17

- PhoneConstants.SENSITIVE / VDEBUG no longer exist: treat both as false.
- ims-ext-common base classes only have (Executor, Context) constructors now:
  pass context.getMainExecutor() and the context the subclass already has.
---
diff --git a/smali/com/qualcomm/ims/utils/Log.smali b/smali/com/qualcomm/ims/utils/Log.smali
index 974669e..377ca7e 100644
--- a/smali/com/qualcomm/ims/utils/Log.smali
+++ b/smali/com/qualcomm/ims/utils/Log.smali
@@ -20,7 +20,7 @@
     .locals 2
 
     .line 32
-    sget-boolean v0, Lcom/android/internal/telephony/PhoneConstants;->SENSITIVE:Z
+    const/4 v0, 0x0
 
     sput-boolean v0, Lcom/qualcomm/ims/utils/Log;->FORCE_DEBUG:Z
 
diff --git a/smali/org/codeaurora/ims/CrsCrbtControllerImpl.smali b/smali/org/codeaurora/ims/CrsCrbtControllerImpl.smali
index e5316af..e7a5d08 100644
--- a/smali/org/codeaurora/ims/CrsCrbtControllerImpl.smali
+++ b/smali/org/codeaurora/ims/CrsCrbtControllerImpl.smali
@@ -37,7 +37,11 @@
     .param p2, "context"    # Landroid/content/Context;
 
     .line 71
-    invoke-direct {p0}, Lorg/codeaurora/ims/CrsCrbtControllerBase;-><init>()V
+    invoke-virtual {p2}, Landroid/content/Context;->getMainExecutor()Ljava/util/concurrent/Executor;
+
+    move-result-object v0
+
+    invoke-direct {p0, v0, p2}, Lorg/codeaurora/ims/CrsCrbtControllerBase;-><init>(Ljava/util/concurrent/Executor;Landroid/content/Context;)V
 
     .line 25
     new-instance v0, Ljava/util/HashMap;
