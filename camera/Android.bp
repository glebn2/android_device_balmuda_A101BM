cc_library_shared {
    name: "camera.balmuda",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["CameraWrapper.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libcamera_metadata",
        "libdl",
        "liblog",
    ],
    compile_multilib: "64",
    cflags: ["-Wall", "-Werror"],
}
