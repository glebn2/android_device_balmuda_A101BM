<resources>
    <!-- Whether device has screen with higher aspect ratio -->
    <bool name="config_haveHigherAspectRatioScreen">true</bool>

    <!-- Defines the actions shown in advanced reboot submenu -->
    <string-array name="config_restartActionsList">
        <item>restart</item>
        <item>restart_recovery</item>
        <item>restart_bootloader</item>
        <item>restart_fastboot</item>
     </string-array>

    <!-- One RGB LED for notifications and battery.
         LIGHTS_RGB_NOTIFICATION_LED (1) | LIGHTS_RGB_BATTERY_LED (2) | LIGHTS_PULSATING_LED (8) | LIGHTS_BATTERY_LED (64) -->
    <integer name="config_deviceLightCapabilities">75</integer>

    <!-- BALMUDA Phone: double tap to wake, the ILITEK KEY_F3 wakes only on the second one in a row -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false">
        <item>/system_ext/app/BalmudaParts/BalmudaParts.apk</item>
    </string-array>
    <string-array name="config_deviceKeyHandlerClasses" translatable="false">
        <item>org.lineageos.balmudaparts.KeyHandler</item>
    </string-array>
</resources>
