//
// BALMUDA gestures (Relax mode, shake to wake) on the stock Kyocera sensors
//

android_app {
    name: "BalmudaParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSettingsTheme",
    ],
    optimize: {
        enabled: false,
    },
}
