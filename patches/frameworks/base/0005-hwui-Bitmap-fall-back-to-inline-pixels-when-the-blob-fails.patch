From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glebn2 <40612835+glebn2@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:00:00 +0300
Subject: [PATCH] hwui: Bitmap: fall back to inline pixels when the blob cannot
 be prepared

If the ashmem/memfd blob for a bitmap cannot be prepared (for example the
process is out of file descriptors) and nothing was written to the parcel
yet, write bitmaps up to BLOB_MAX_INPLACE_LIMIT inline instead of throwing
"Could not copy bitmap to parcel blob". Pixels are preserved; larger
bitmaps fail as before. Writes use WriteFully.
---
 libs/hwui/jni/Bitmap.cpp | 70 +++++++++++++++++-----------------------
 1 file changed, 29 insertions(+), 41 deletions(-)

diff --git a/libs/hwui/jni/Bitmap.cpp b/libs/hwui/jni/Bitmap.cpp
index d97d1bc..37052a2 100644
--- a/libs/hwui/jni/Bitmap.cpp
+++ b/libs/hwui/jni/Bitmap.cpp
@@ -1,6 +1,7 @@
 // #define LOG_NDEBUG 0
 #include "Bitmap.h"
 
+#include <android-base/file.h>
 #include <android-base/unique_fd.h>
 #include <com_android_graphics_hwui_flags.h>
 #include <fcntl.h>
@@ -786,53 +787,40 @@ static binder_status_t writeBlob(AParcel* parcel, uint64_t bitmapId, const SkBit
                                  bool immutable) {
     const size_t size = bitmap.computeByteSize();
     const void* data = bitmap.getPixels();
-
-    if (size <= 0 || data == nullptr) {
-        return STATUS_NOT_ENOUGH_DATA;
-    }
+    if (size <= 0 || data == nullptr) return STATUS_NOT_ENOUGH_DATA;
     binder_status_t error = STATUS_OK;
     if (shouldUseAshmem(parcel, size)) {
-        // Create new ashmem region with read/write priv
         auto ashmemId = Bitmap::getAshmemId("writeblob", bitmapId,
                                             bitmap.width(), bitmap.height(), size);
         base::unique_fd fd;
-
-        fd.reset(syscall(__NR_memfd_create, ashmemId.c_str(), MFD_CLOEXEC | MFD_ALLOW_SEALING));
-        if (fd.get() < 0) {
-            return STATUS_NO_MEMORY;
-        }
-
-        ssize_t written = write(fd.get(), data, size);
-        if (written != size) {
-            return STATUS_NO_MEMORY;
-        }
-
-        if (fcntl(fd, F_ADD_SEALS,
-                    // Disallow growing / shrinking.
-                    F_SEAL_GROW | F_SEAL_SHRINK
-                    // If immutable, disallow writing.
-                    // Use F_SEAL_FUTURE_WRITE instead of F_SEAL_WRITE to work around a bug in
-                    // pre-6.7 kernels.
-                    // There are no writable mappings made prior to this, so both seals are
-                    // functionally equivalent.
-                    // See: b/409846908#comment39
-                    | (immutable ? F_SEAL_FUTURE_WRITE : 0))) {
-            return STATUS_UNKNOWN_ERROR;
-        }
-
-        // Workaround b/149851140 in AParcel_writeParcelFileDescriptor
-        int rawFd = fd.release();
-        error = writeBlobFromFd(parcel, size, rawFd);
-        close(rawFd);
-        return error;
-    } else {
-        if (size > BLOB_MAX_INPLACE_LIMIT) {
-            return STATUS_FAILED_TRANSACTION;
+        const binder_status_t createStatus = [&]() -> binder_status_t {
+            fd.reset(syscall(__NR_memfd_create, ashmemId.c_str(), MFD_CLOEXEC | MFD_ALLOW_SEALING));
+            if (fd.get() < 0) return STATUS_NO_MEMORY;
+            if (!android::base::WriteFully(fd.get(), data, size)) return STATUS_NO_MEMORY;
+            // Keep FUTURE_WRITE: F_SEAL_WRITE breaks read-only shared mappings on this kernel.
+            if (fcntl(fd, F_ADD_SEALS,
+                    F_SEAL_GROW | F_SEAL_SHRINK | (immutable ? F_SEAL_FUTURE_WRITE : 0))) {
+                return STATUS_UNKNOWN_ERROR;
+            }
+            return STATUS_OK;
+        }();
+        if (createStatus == STATUS_OK) {
+            // Workaround b/149851140 in AParcel_writeParcelFileDescriptor.
+            int rawFd = fd.release();
+            error = writeBlobFromFd(parcel, size, rawFd);
+            close(rawFd);
+            return error;
         }
-        ON_ERROR_RETURN(AParcel_writeInt32(parcel, static_cast<int32_t>(BlobType::IN_PLACE)));
-        ON_ERROR_RETURN(AParcel_writeByteArray(parcel, static_cast<const int8_t*>(data), size));
-        return STATUS_OK;
-    }
+        ALOGW("Bitmap blob memfd preparation failed (status=%d, errno=%d, bytes=%zu)",
+                createStatus, errno, size);
+        if (size > BLOB_MAX_INPLACE_LIMIT) return createStatus;
+        // BALMUDA: no Parcel bytes have been written before this fallback.
+        // Reuse the existing bounded in-place format, preserving the bitmap pixels.
+    }
+    if (size > BLOB_MAX_INPLACE_LIMIT) return STATUS_FAILED_TRANSACTION;
+    ON_ERROR_RETURN(AParcel_writeInt32(parcel, static_cast<int32_t>(BlobType::IN_PLACE)));
+    ON_ERROR_RETURN(AParcel_writeByteArray(parcel, static_cast<const int8_t*>(data), size));
+    return STATUS_OK;
 }
 
 #undef ON_ERROR_RETURN
