From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glebn2 <40612835+glebn2@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:00:00 +0300
Subject: [PATCH] bpfloader: don't abort on failed critical objects on a 4.19
 kernel

BALMUDA Phone runs the stock Kyocera 4.19 kernel: ringbuf-based critical
objects (5.8+) and the vendor filterPowerSupplyEvents.o cannot load there.
Log the failure instead of panicking / exiting (reboot,bpfloader-failed).
---
 loader/Loader.cpp   | 3 ++-
 loader/bpfloader.rs | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/loader/Loader.cpp b/loader/Loader.cpp
index 08c6b6d..13dee36 100644
--- a/loader/Loader.cpp
+++ b/loader/Loader.cpp
@@ -574,7 +574,8 @@ static bool loadAllElfObjects() {
 
             bool critical;
             if (!loadProg(progPath.c_str(), &critical)) {
-                if (critical) success = false;
+                // A101BM: vendor object failure is not fatal on 4.19.
+                if (critical) ALOGE("A101BM: critical vendor object failed, continuing");
                 ALOGE("Failed to load object: %s", progPath.c_str());
             }
         }
diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index f23d882..bd52164 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -733,7 +733,8 @@ fn load_libbpf_progs() {
     for file_desc in file_vec {
         if let Err(e) = libbpf_worker(&file_desc) {
             if file_desc.critical {
-                panic!("Error when loading {0}: {e}", file_desc.filename);
+                // A101BM: not fatal on 4.19 without ringbuf/BTF.
+                error!("A101BM: critical {0} failed, continuing: {e}", file_desc.filename);
             } else {
                 error!("Error when loading {0}: {e}", file_desc.filename);
             }
